{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CleanNav Task Request v1.0",
  "type": "object",
  "required": [
    "command_id",
    "task_id",
    "timestamp_ms",
    "valid_for_ms"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "valid_for_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    }
  },
  "additionalProperties": false
}
